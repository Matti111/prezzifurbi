# Copia questo file in ".env" (che resta escluso da git) e inserisci i valori reali.
# In GitHub Actions le stesse variabili vanno inserite come Repository Secrets,
# non in questo file.

AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# eBay Developer Program (developer.ebay.com) - Application Keys, ambiente Production.
# Diverse dal Campaign ID del Partner Network (quello serve solo al tracking dei click).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Awin - Publisher ID (MyAwin > Account). Non e' un segreto (e' nei link pubblici),
# ma va qui per non doverlo modificare nel codice.
AWIN_AFFID=
